<?xml version="1.0" encoding="utf-8"?>
<!-- 
    REPLACE THIS FILE WITH YOUR CUSTOM BOTTOM NAVIGATION IMAGE
    
    1. Add your bottom navigation design image (PNG/JPG) to the drawable folder
    2. Name it something like: your_bottom_nav_design.png
    3. Update the src attribute below to reference your image
    
    Example: android:src="@drawable/your_bottom_nav_design"
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- This is a placeholder - replace with your actual design -->
    <item>
        <layer-list>
            <!-- Background -->
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/wype_primary_dark" />
                </shape>
            </item>
            
            <!-- Your button areas (customize these positions) -->
            <item android:left="20dp" android:right="20dp" android:top="10dp" android:bottom="10dp">
                <shape android:shape="rectangle">
                    <corners android:radius="8dp" />
                    <stroke android:width="1dp" android:color="@color/wype_secondary" />
                    <solid android:color="@android:color/transparent" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
