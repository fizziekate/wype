<?xml version="1.0" encoding="utf-8"?>
<!-- Replace this with your custom bottom navigation design -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Base background -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/wype_primary_dark" />
        </shape>
    </item>
    
    <!-- Optional: Top border -->
    <item>
        <shape android:shape="rectangle">
            <stroke 
                android:width="1dp" 
                android:color="@color/wype_secondary" />
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
    
    <!-- Optional: Gradient overlay -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="@color/wype_primary"
                android:endColor="@color/wype_primary_dark"
                android:angle="90" />
        </shape>
    </item>
</layer-list>
